# Public application URL used when real integrations are connected.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only URL of the backend API. Production must use HTTPS.
# The browser only calls the same-origin /api/backend route; do not expose tokens
# or private backend URLs through NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public checkout identifier only. Never place a Razorpay secret in NEXT_PUBLIC_*.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me

# Server-only placeholders for a future backend integration.
RAZORPAY_KEY_SECRET=
RESEND_API_KEY=
WHATSAPP_ACCESS_TOKEN=
AI_SERVICE_API_KEY=
DATABASE_URL=
